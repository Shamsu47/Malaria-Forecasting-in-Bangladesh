# ============================================================
# POSTER GRAPHS: POISSON & NEGATIVE BINOMIAL GLM
# (WITH & WITHOUT OFFSET) — EXACT MLE AIC = 525.82
# ============================================================

ref_formula = "malaria_cases ~ y5 + y15"

# 1. Poisson GLM without Offset
pois_ref_no = smf.glm(
    ref_formula,
    data=bd_clean,
    family=sm.families.Poisson()
).fit()

# 2. Poisson GLM with Population Offset
pois_ref_off = smf.glm(
    ref_formula,
    data=bd_clean,
    family=sm.families.Poisson(),
    offset=bd_clean["log_pop"]
).fit()

# 3. Negative Binomial GLM without Offset (MLE estimated alpha)
nb_ref_no = smf.negativebinomial(
    ref_formula,
    data=bd_clean
).fit(disp=False)

# 4. Negative Binomial GLM with Population Offset (MLE estimated alpha -> AIC = 525.82)
nb_ref_off = smf.negativebinomial(
    ref_formula,
    data=bd_clean,
    offset=bd_clean["log_pop"]
).fit(disp=False)

# ------------------------------------------------------------
# STORE PREDICTIONS
# ------------------------------------------------------------
bd_clean["Pred_Pois_No"] = pois_ref_no.predict(bd_clean)
bd_clean["Pred_Pois_Off"] = pois_ref_off.predict(bd_clean, offset=bd_clean["log_pop"])
bd_clean["Pred_NB_No"] = nb_ref_no.predict(bd_clean)
bd_clean["Pred_NB_Off"] = nb_ref_off.predict(bd_clean, offset=bd_clean["log_pop"])

# ------------------------------------------------------------
# MODEL COMPARISON USING AIC
# ------------------------------------------------------------
model_aics = {
    "Poisson GLM (Without Offset)": pois_ref_no.aic,
    "Poisson GLM (With Offset)": pois_ref_off.aic,
    "Negative Binomial GLM (Without Offset)": nb_ref_no.aic,
    "Negative Binomial GLM (With Offset)": nb_ref_off.aic
}

print("MODEL AIC COMPARISON:")
for name, aic in model_aics.items():
