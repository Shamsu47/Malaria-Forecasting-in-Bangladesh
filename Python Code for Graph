def render_poster_table(headers, rows, col_widths, filename, highlight_row=None, figsize=(10.5, 3.2)):
    fig, ax = plt.subplots(figsize=figsize, dpi=300)
    ax.axis("off")

    table = ax.table(
        cellText=rows,
        colLabels=headers,
        colWidths=col_widths,
        loc="center",
        cellLoc="center"
    )

    table.auto_set_font_size(False)
    table.set_fontsize(10)
    table.scale(1, 2.15)

    for (row, col), cell in table.get_celld().items():
        cell.set_edgecolor("#cbd2dc")
        cell.set_linewidth(0.8)
        txt = cell.get_text()
        txt.set_fontname("Arial")

        # Left-align first column (text labels)
        if col == 0:
            txt.set_ha("left")
            cell.PAD = 0.04

        # Header styling
        if row == 0:
            cell.set_facecolor("#0b2d52")
            txt.set_color("white")
            txt.set_weight("bold")
            txt.set_fontsize(10.5)
        else:
            # Highlight best/significant row
            if highlight_row is not None and row == highlight_row:
                cell.set_facecolor("#e6f0fa")
                txt.set_weight("bold")
                txt.set_color("#0b2d52")
            else:
                cell.set_facecolor("#ffffff" if row % 2 == 1 else "#f4f6f9")
                txt.set_color("#111111")

    plt.tight_layout()
    plt.savefig(filename, dpi=300, bbox_inches="tight", facecolor="white")
    plt.show()

